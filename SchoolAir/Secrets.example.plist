<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Copy this file to Secrets.plist (gitignored) and fill in the values. Blank values mean "not configured". -->

	<!-- Firebase Auth UID of the phone that approves family viewers. Must match OWNER_UID_PLACEHOLDER in Firebase/database.rules.json. -->
	<key>FIREBASE_OWNER_UID</key>
	<string></string>
	<!-- Firebase Auth UID the sensor boxes upload with. Must match SENSOR_UID_PLACEHOLDER in Firebase/database.rules.json. -->
	<key>FIREBASE_SENSOR_UID</key>
	<string></string>

	<!-- Optional. Free key from docs.airnowapi.org. Without it the app uses the Open-Meteo/CAMS regional model. -->
	<key>AIRNOW_API_KEY</key>
	<string></string>
	<!-- ZIP code AirNow should report on. 47708 is downtown Evansville, IN. -->
	<key>AIRNOW_ZIP</key>
	<string>47708</string>
</dict>
</plist>
